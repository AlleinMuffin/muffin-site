---
/**
 * 整合包下载入口。
 * variant="panel"：完整卡片，放在 /mcserver；variant="band"：横向条带，放在首页。
 * 链接全部来自 src/config/site.ts 的 modpack 配置，不在这里硬编码地址。
 */
import { siteConfig, modpackDownloadUrl, modpackReleaseUrl } from "../config/site";

interface Props {
  variant?: "panel" | "band";
}

const { variant = "panel" } = Astro.props;
const p = siteConfig.modpack;
const downloadUrl = modpackDownloadUrl();
const releaseUrl = modpackReleaseUrl();

const meta = [
  { label: "整合包版本", value: p.version },
  { label: "游戏版本", value: p.gameVersion },
  { label: "加载器", value: p.loader },
  { label: "体积", value: p.size },
  { label: "更新于", value: p.updated },
];

/** 前 12 位 + 后 8 位，够肉眼比对又不占太大地方，完整值靠复制按钮 */
const shortHash = `${p.sha256.slice(0, 12)}…${p.sha256.slice(-8)}`;
---

{
  variant === "band" ? (
    <div class="dl-band" data-reveal>
      <div>
        <p class="dl-band__kicker mono">MODPACK DOWNLOAD</p>
        <h2 class="dl-band__title">下载客户端整合包</h2>
        <p class="dl-band__desc">
          {p.version} · Minecraft {p.gameVersion} · {p.loader} · {p.size}
        </p>
      </div>
      <div class="dl-band__actions">
        <a class="btn btn--primary" href={downloadUrl} download={p.file}>
          <svg class="dl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" />
            <path d="m7 11 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          立即下载
        </a>
        {p.mirrors.length > 0 && (
          <a class="btn btn--ghost" href={p.mirrors[0].url} download={p.file}>
            国内加速
          </a>
        )}
        <a class="btn btn--ghost" href="/mcserver">服务器详情 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  ) : (
    <div class="dl-card" data-reveal>
      <div class="dl-card__top">
        <div>
          <p class="dl-card__kicker mono">MODPACK DOWNLOAD</p>
          <h3 class="dl-card__title">客户端整合包</h3>
          <p class="dl-card__desc">
            和服务器完全对齐的客户端模组包，下载后用启动器导入，或解压覆盖到游戏目录的
            <code>mods</code> 文件夹。
          </p>
        </div>

        <div class="dl-card__actions">
          <a class="btn btn--primary" href={downloadUrl} download={p.file}>
            <svg class="dl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12" />
              <path d="m7 11 5 5 5-5" />
              <path d="M5 21h14" />
            </svg>
            下载整合包
          </a>
          <a class="btn btn--ghost" href={releaseUrl} target="_blank" rel="noopener noreferrer">
            更新说明 <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      {p.mirrors.length > 0 && (
        <div class="dl-mirrors">
          <p class="dl-mirrors__title">
            国内高速镜像
            <span>GitHub 直连慢时换这里，文件完全一样</span>
          </p>
          <div class="dl-mirrors__list">
            {p.mirrors.map((m) => (
              <a class="btn btn--ghost btn--sm" href={m.url} download={p.file}>
                {m.label}
              </a>
            ))}
            <a class="btn btn--ghost btn--sm" href="/download">全部线路与校验 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      )}

      <dl class="dl-meta">
        {meta.map((m) => (
          <div class="dl-meta__item">
            <dt>{m.label}</dt>
            <dd class="mono">{m.value}</dd>
          </div>
        ))}
      </dl>

      <div class="dl-hash">
        <span class="dl-hash__label">SHA-256</span>
        <code class="dl-hash__value mono" title={p.sha256}>{shortHash}</code>
        <button type="button" class="btn--copy" data-copy-value={p.sha256}>
          <span data-copy-label>复制校验值</span>
        </button>
      </div>

      <p class="dl-note">
        下载后用这个校验值核对文件，确认和你预期的一致：Windows 可用
        <code>certutil -hashfile 文件名 SHA256</code>，macOS / Linux 用
        <code>sha256sum 文件名</code>。
        整合包内模组版权归各自作者所有，仅供非商业用途。
      </p>
    </div>
  )
}

<script>
  import { initCopyValue } from "../scripts/copy-value";
  initCopyValue();
</script>
