---
/** 单个项目卡。数据驱动，新增项目只改 src/data/projects.ts。 */
import type { Project } from "../data/projects";
import { siteConfig } from "../config/site";

interface Props {
  project: Project;
  /** 是否显示「查看详情」链接 */
  showDetail?: boolean;
}

const { project, showDetail = true } = Astro.props;
const repo = project.github ?? siteConfig.github;
---

<article class="project-card" data-reveal data-tags={project.tags.join("|")}>
  <h4 class="project-card__title">{project.name}</h4>
  <p class="project-card__desc">{project.description}</p>

  <div class="project-card__tags">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
    {project.version && <span class="tag mono">{project.version}</span>}
  </div>

  <div class="project-card__links">
    <a class="project-card__link mono" href={repo} target="_blank" rel="noopener noreferrer">
      GitHub <span aria-hidden="true">↗</span>
    </a>
    {
      showDetail && (
        <a class="project-card__link mono" href={`/projects/${project.slug}`}>
          详情 <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>
