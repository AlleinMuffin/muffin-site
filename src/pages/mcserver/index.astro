---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import ServerStatusCard from "../../components/ServerStatusCard.astro";
import Gallery from "../../components/Gallery.astro";
import { siteConfig } from "../../config/site";
import { announcements, rules, joinSteps } from "../../data/mcserver";
import { mods, modCategories, modCount } from "../../data/mods";

const mc = siteConfig.mc;
---

<BaseLayout title={`${mc.name} — ${siteConfig.siteName}`} description={mc.intro}>
  <!-- ========================= 头部大图 ========================= -->
  <section class="page-hero">
    <div class="page-hero__media" aria-hidden="true"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__label">Minecraft Server</p>
      <h1 class="page-hero__title">{mc.name}</h1>
      <p class="page-hero__desc">{mc.intro}</p>
      <div class="page-hero__actions">
        <a class="btn btn--primary" href="#join">加入服务器</a>
        <a class="btn btn--ghost" href="/">返回首页 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ========================= 状态卡片 ========================= -->
  <section class="section" id="status">
    <div class="container">
      <SectionHead label="Server Status" title="实时状态" desc="版本、在线人数与 MOTD 每 60 秒自动刷新。" />
      <ServerStatusCard showHint={false} />
    </div>
  </section>

  <!-- ==================== 模组 / 公告 / 规则 ==================== -->
  <section class="section" id="mods">
    <div class="container">
      <SectionHead
        label="Modpack"
        title="模组清单"
        desc={`当前整合包共 ${modCount} 个模组，从整合包仓库自动同步。完整文件见仓库 mods/ 目录。`}
      />

      <div class="panel" data-reveal>
        <h3 class="panel__title">模组列表</h3>
        <p class="panel__desc">版本随整合包更新而变动，以仓库里的实际文件为准。</p>

        <div class="mod-toolbar">
          <label class="mod-search">
            <span class="mod-search__icon" aria-hidden="true">⌕</span>
            <input
              id="mod-search"
              type="search"
              placeholder="搜索模组名或文件名…"
              aria-label="搜索模组"
              autocomplete="off"
            />
          </label>
          <span class="mod-count" id="mod-count" aria-live="polite">
            显示 <b>{modCount}</b> / {modCount}
          </span>
        </div>

        <div class="mod-chips" id="mod-chips" role="group" aria-label="按分类筛选">
          <button type="button" class="mod-chip is-active" data-cat="all">全部 {modCount}</button>
          {
            modCategories.map((c) => (
              <button type="button" class="mod-chip" data-cat={c}>
                {c} {mods.filter((m) => m.category === c).length}
              </button>
            ))
          }
        </div>

        <div class="mod-list" id="mod-list">
          {
            mods.map((m) => (
              <div class="mod-item" data-cat={m.category} data-key={`${m.name} ${m.file}`.toLowerCase()}>
                <div class="mod-item__top">
                  <span class="mod-item__name">{m.name}</span>
                  <span class="mod-item__ver">{m.version}</span>
                </div>
                <span class="mod-item__meta" title={m.file}>{m.file}</span>
              </div>
            ))
          }
        </div>
        <p class="mod-empty is-hidden" id="mod-empty">没有匹配的模组，换个关键词试试。</p>
      </div>

      <div class="panel" data-reveal>
        <h3 class="panel__title">模组更新检测</h3>
        <p class="panel__desc">
          用 Muffin Launcher 或下面的命令比对本地与服务器的模组差异，只下载变化的部分。
        </p>
        <div class="terminal" style="margin-top:18px">
          <div class="terminal__bar"><span></span><span></span><span></span></div>
          <pre class="terminal__body mono">$ muffin check --server {mc.host} --profile latest
<i>✔</i> {modCount} mods 已同步
<i>!</i> 0 mods 需要更新</pre>
        </div>
      </div>

      <div class="panel" data-reveal>
        <h3 class="panel__title">公告</h3>
        <div class="notice-list">
          {
            announcements.map((n) => (
              <div class="notice">
                <div class="notice__date mono">{n.date}</div>
                <div class="notice__text">{n.text}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="panel" data-reveal>
        <h3 class="panel__title">规则</h3>
        <div class="rules">
          {
            rules.map((r) => (
              <p class="rule">
                <span class="rule__dot" aria-hidden="true" />
                <span>{r}</span>
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ========================== 加入指南 ========================== -->
  <section class="section" id="join">
    <div class="container">
      <SectionHead label="How to Join" title="加入指南" desc="四步进服，遇到问题可以在 GitHub 提 Issue。" />
      <div class="panel" data-reveal>
        <div class="steps">
          {
            joinSteps.map((s, i) => (
              <div class="step">
                <span class="step__no">{i + 1}</span>
                <p class="step__body" set:html={s.replace("{host}", mc.host)} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ========================== 完整相册 ========================== -->
  <section class="section" id="gallery">
    <div class="container">
      <SectionHead label="Gallery" title="世界图鉴（完整版）" desc="点击任意图片放大，支持左右切换与 Esc 关闭。" />
      <Gallery />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p><a class="btn btn--ghost" href="/">返回首页 <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <script>
    import { initModFilter } from "../../scripts/mod-filter";
    initModFilter();
  </script>
</BaseLayout>
